<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        android:padding="16dp">

        <!-- Screen Title -->
        <TextView
            android:id="@+id/tv_screen_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_investment_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:accessibilityHeading="true"
            android:layout_marginBottom="12dp" />

        <!-- Amount -->
        <TextView
            android:id="@+id/label_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_amount"
            android:labelFor="@id/et_amount" />
        <EditText
            android:id="@+id/et_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:importantForAutofill="no"
            android:autofillHints="transactionAmount"
            android:layout_marginBottom="12dp" />

        <!-- Investment Type Spinner -->
        <TextView
            android:id="@+id/label_investment_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_investment_type"
            android:labelFor="@id/spinner_category" />
        <Spinner
            android:id="@+id/spinner_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:spinnerMode="dialog"
            android:contentDescription="@string/label_investment_type"
            android:prompt="@string/label_investment_type"
            android:importantForAutofill="no"
            android:autofillHints="none"
            android:layout_marginBottom="12dp" />

        <!-- Return Rate (Optional) -->
        <TextView
            android:id="@+id/label_return_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_return_rate"
            android:labelFor="@id/et_return_rate" />
        <EditText
            android:id="@+id/et_return_rate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:importantForAutofill="no"
            android:autofillHints="none"
            android:layout_marginBottom="12dp" />

        <!-- Investment Date -->
        <TextView
            android:id="@+id/label_investment_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_investment_date"
            android:labelFor="@id/et_date" />
        <EditText
            android:id="@+id/et_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/select_date"
            android:inputType="none"
            android:focusable="false"
            android:importantForAutofill="no"
            android:layout_marginBottom="12dp" />

        <!-- Maturity Date (Optional) -->
        <TextView
            android:id="@+id/label_maturity_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_maturity_date"
            android:labelFor="@id/et_maturity_date" />
        <EditText
            android:id="@+id/et_maturity_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/select_date"
            android:inputType="none"
            android:focusable="false"
            android:importantForAutofill="no"
            android:layout_marginBottom="12dp" />

        <!-- Investment Account Number (Optional) -->
        <TextView
            android:id="@+id/label_account_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_account_number"
            android:labelFor="@id/et_account_number" />
        <EditText
            android:id="@+id/et_account_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_account_number"
            android:inputType="textCapCharacters"
            android:importantForAutofill="no"
            android:autofillHints="none"
            android:layout_marginBottom="12dp" />

        <!-- Institution name -->
        <TextView
            android:id="@+id/label_institution_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_institution_name"
            android:labelFor="@id/et_institution_name" />
        <EditText
            android:id="@+id/et_institution_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:importantForAutofill="no"
            android:autofillHints="none"
            android:layout_marginBottom="12dp" />

        <!-- Additional Notes -->
        <TextView
            android:id="@+id/label_notes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_notes"
            android:labelFor="@id/et_notes" />
        <EditText
            android:id="@+id/et_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:hint="@string/hint_notes"
            android:importantForAutofill="no"
            android:autofillHints="none"
            android:layout_marginBottom="16dp" />

        <!-- Buttons -->
        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save" />

        <Button
            android:id="@+id/btn_delete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/delete"
            android:visibility="gone"
            android:backgroundTint="@android:color/holo_red_dark" />

    </LinearLayout>

</ScrollView>
